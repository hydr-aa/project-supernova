# Project Supernova — Environment Variables
# Copy this file to .env and fill in your values.

# LDAP service account password (required for live mode)
LDAP_PASSWORD=your_ldap_password_here

# Set to 1 to bypass the authorization gate in dev mode
SUPERNOVA_AUTHORIZED=1

# Discord webhook URL for Real-Time Guard alerts (optional)
# DISCORD_WEBHOOK=https://discord.com/api/webhooks/...
